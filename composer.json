{
    "name": "therealmattlear/php-mysql-shim",
    "description": "A PHP 7 and 8 shim for ext/mysql",
    "license": "MIT",
    "authors": [
        {
            "name": "Davey Shafik",
            "email": "me@daveyshafik.com",
            "homepage": "https://daveyshafik.com"
        }
    ],
    "require": {
        "php": ">=7.0",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5 || ^7.5 || ^8.5 || ^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "yoast/phpunit-polyfills": "^3.1.2"
    },
    "replace": {
        "dshafik/php7-mysql-shim": "self.version"
    },
    "autoload": {
        "files": ["lib/mysql.php"]
    },
    "scripts": {
        "test": "phpunit",
        "fix-cs": "phpcbf --standard=PSR1,PSR2 ./lib ./tests"
    }
}
